# ------------------------------------------------------------------------------
# Runtime profile
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# Database connection (required in dev/qa/prod)
# ------------------------------------------------------------------------------
# Local example:
DB_URL=jdbc:postgresql://localhost:5432/fixpoint

# Cloud example (uncomment and adapt host/port/db):
# DB_URL=jdbc:postgresql://your-host:5432/your-db?sslmode=require

DB_USERNAME=postgres
DB_PASSWORD=adminpostgresql

# ------------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call this API)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ------------------------------------------------------------------------------
# File upload and server-side date baseline
# ------------------------------------------------------------------------------
FILE_UPLOAD_DIR=uploads
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ------------------------------------------------------------------------------
# Access token (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET must have at least 32 characters.
# Generate example: openssl rand -base64 48
JWT_SECRET=fixpoint-dev-jwt-secret-change-me-2026

# Access token lifetime in seconds (recommended short-lived)
JWT_ACCESS_EXPIRATION_SECONDS=900

# ------------------------------------------------------------------------------
# Refresh session policy
# ------------------------------------------------------------------------------
# Lifetime without "remember me"
AUTH_REFRESH_EXPIRATION_SECONDS=43200

# Lifetime with "remember me" (must be >= AUTH_REFRESH_EXPIRATION_SECONDS)
AUTH_REFRESH_REMEMBER_EXPIRATION_SECONDS=2592000

# ------------------------------------------------------------------------------
# Refresh cookie settings
# ------------------------------------------------------------------------------
AUTH_REFRESH_COOKIE_NAME=fixpoint_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/auth

# Allowed values: Lax, Strict, None
AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# For local HTTP use false.
# For HTTPS and SameSite=None use true.
AUTH_REFRESH_COOKIE_SECURE=false

# Optional: set only if you need shared cookie across subdomains.
AUTH_REFRESH_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Production bootstrap user (prod profile only)
# ------------------------------------------------------------------------------
# Leave empty in dev/qa unless you intentionally seed a bootstrap user there.
AUTH_BOOTSTRAP_ADMIN_USERNAME=

# BCrypt hash only (never plain password).
# You can generate a hash through backend register in dev and copy password_hash from DB.
AUTH_BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Allowed values: ADMIN, TECH
AUTH_BOOTSTRAP_ADMIN_ROLE=ADMIN
